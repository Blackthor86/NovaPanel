# Node.js 22 is recommended; Node.js 20+ is supported.
# Keep this directory on persistent writable storage.
NOVAPANEL_DATA_DIR=./bk-data

# The provider normally injects PORT. If both exist, PORT takes precedence over SERVER_PORT.
# NOVAPANEL_PUBLIC_HOST=panel.example.com
# NOVAPANEL_PUBLIC_BASE_URL=https://panel.example.com
# NOVAPANEL_LINK_PORT=443
# NOVAPANEL_LINK_MODE=direct
# NOVAPANEL_REALITY_SNI=www.cloudflare.com
# PANEL_PATH=knight
# NODE_PREFIX=NovaPanel -

# Optional: choose the admin password by hosting secret instead of the first-run page.
# PANEL_PASSWORD=choose-a-long-random-password
# SETUP_KEY=an-extra-key-required-only-on-first-setup
# SUB_TOKEN=use-a-long-random-subscription-token

# sing-box is the primary engine; direct mode also uses Xray for XHTTP and Shadowsocks.
# Both binaries install automatically on supported Linux hosts.
NOVAPANEL_AUTO_INSTALL_ENGINES=1
NOVAPANEL_SINGBOX_VERSION=1.11.15
# NOVAPANEL_SINGBOX_BINARY=/absolute/path/to/sing-box
# NOVAPANEL_SINGBOX_URL=https://github.com/SagerNet/sing-box/releases/download/v1.11.15/sing-box-1.11.15-linux-amd64.tar.gz
# NOVAPANEL_XRAY_BINARY=/absolute/path/to/xray
# Legacy alias: NOVAPANEL_AUTO_INSTALL_XRAY=1
# Temporary protocol diagnostics only; avoid enabling these on public production logs.
# NOVAPANEL_XRAY_LOGLEVEL=debug
# NOVAPANEL_XRAY_REALITY_SHOW=1
# NOVAPANEL_XRAY_URL=https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip

# Use edge only if the provider terminates public HTTPS and forwards WebSocket upgrades.
# NOVAPANEL_LINK_MODE=edge
