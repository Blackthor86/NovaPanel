# Copy this file to .env and set a long random value before any remote deployment.
NOVAPANEL_SECRET_KEY=replace-with-a-long-random-secret
NOVAPANEL_COOKIE_SECURE=0
NOVAPANEL_DATA_DIR=./data
NOVAPANEL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional: full path to an Xray executable that you installed and verified yourself.
# NOVAPANEL_XRAY_BINARY=C:\tools\xray\xray.exe
