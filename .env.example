# Recommended runtime: Node.js 22 (Node.js 20+ supported)
# Use a persistent writable volume to keep the password, UUID, TLS certificate and subscription URL.
NOVAPANEL_DATA_DIR=./bk-data

# Public HTTP/TCP listener. The hosting provider usually injects SERVER_PORT.
# NOVAPANEL_PUBLIC_HOST=panel.example.com
# NOVAPANEL_PUBLIC_BASE_URL=https://panel.example.com
# NOVAPANEL_LINK_PORT=443
# NOVAPANEL_LINK_MODE=direct

# First-run password is normally chosen at /knight/login.
# Set this only when you want to seed/reset it through a secret.
# PANEL_PASSWORD=choose-a-long-random-password
# SETUP_KEY=an-extra-key-required-only-on-first-setup
# PANEL_PATH=knight
# NODE_PREFIX=NovaPanel -

# Xray-core is installed automatically on supported Linux hosts.
# Set to 0 only if you explicitly want the panel without a working proxy engine.
NOVAPANEL_AUTO_INSTALL_XRAY=1
# NOVAPANEL_XRAY_BINARY=/absolute/path/to/xray
# NOVAPANEL_XRAY_URL=https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip

# Optional stable subscription token; leave unset for a randomly generated secret token.
# SUB_TOKEN=use-a-long-random-subscription-token
