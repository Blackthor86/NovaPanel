# Copy this file to .env and set a long random value before any remote deployment.
NOVAPANEL_SECRET_KEY=replace-with-a-long-random-secret
NOVAPANEL_COOKIE_SECURE=0
NOVAPANEL_DATA_DIR=./data
NOVAPANEL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional: full path to an Xray executable that you installed and verified yourself.
# NOVAPANEL_XRAY_BINARY=C:\tools\xray\xray.exe

# Public HTTPS origin used when creating client subscription links.
# NOVAPANEL_PUBLIC_BASE_URL=https://panel.example.com

# Deployment mode: auto, paas_ws (TLS-terminated app host with WebSocket support), or direct (VPS).
NOVAPANEL_DEPLOYMENT_MODE=auto
# Optional hostname override if the host cannot be inferred.
# NOVAPANEL_PUBLIC_HOST=panel.example.com
# Private local Xray WS listener in paas_ws mode.
NOVAPANEL_XRAY_WS_PORT=10086
